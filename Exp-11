
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    int key[2][2] = {{9, 4}, {5, 7}};
    int inv[2][2] = {{5, 12}, {15, 25}};
    char input[200], p[200], c[200], d[200];
    int len = 0, i, a, b;

    printf("Enter plaintext: ");
    fgets(input, sizeof(input), stdin);

    for (i = 0; input[i] != '\0'; i++) {
        if (isalpha((unsigned char)input[i]))
            p[len++] = toupper((unsigned char)input[i]);
    }

    if (len % 2 != 0)
        p[len++] = 'X';
    p[len] = '\0';

    for (i = 0; i < len; i += 2) {
        a = p[i] - 'A';
        b = p[i + 1] - 'A';
        c[i] = (key[0][0] * a + key[0][1] * b) % 26 + 'A';
        c[i + 1] = (key[1][0] * a + key[1][1] * b) % 26 + 'A';
    }
    c[len] = '\0';

    for (i = 0; i < len; i += 2) {
        a = c[i] - 'A';
        b = c[i + 1] - 'A';
        d[i] = (inv[0][0] * a + inv[0][1] * b) % 26 + 'A';
        d[i + 1] = (inv[1][0] * a + inv[1][1] * b) % 26 + 'A';
    }
    d[len] = '\0';

    printf("Ciphertext: %s\n", c);
    printf("Decrypted plaintext: %s\n", d);

    return 0;
}
