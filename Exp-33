/* Key Schedule */
void des_key_schedule(uint64_t key64, uint64_t subkeys[16]) {
    int key_bits[64], cd[56];
    int C[28], D[28];
    int i, r, s;

    for (i = 0; i < 64; i++) {
        key_bits[i] = (key64 >> (63 - i)) & 1;
    }
    for (i = 0; i < 56; i++) {
        cd[i] = key_bits[PC1[i] - 1];
    }
    for (i = 0; i < 28; i++) {
        C[i] = cd[i];
        D[i] = cd[28 + i];
    }

    for (r = 0; r < 16; r++) {
        s = SHIFTS[r];
        int tempC[28], tempD[28], combined[56];
        for (i = 0; i < 28; i++) {
            tempC[i] = C[(i + s) % 28];
            tempD[i] = D[(i + s) % 28];
            C[i] = tempC[i];
            D[i] = tempD[i];
            combined[i] = C[i];
            combined[28 + i] = D[i];
        }

        subkeys[r] = 0;
        for (i = 0; i < 48; i++) {
            subkeys[r] = (subkeys[r] << 1) | combined[PC2[i] - 1];
        }
    }
}

/* Round Function F(R, K) */
uint32_t des_feistel(uint32_t R, uint64_t K) {
    int r_bits[32], ep[48];
    int s_out[32];
    uint32_t result = 0;
    int i;

    for (i = 0; i < 32; i++) {
        r_bits[i] = (R >> (31 - i)) & 1;
    }
    for (i = 0; i < 48; i++) {
        ep[i] = r_bits[E[i] - 1] ^ ((K >> (47 - i)) & 1);
    }

    for (i = 0; i < 8; i++) {
        int row = (ep[i * 6] << 1) | ep[i * 6 + 5];
        int col = (ep[i * 6 + 1] << 3) | (ep[i * 6 + 2] << 2) |
                  (ep[i * 6 + 3] << 1) | ep[i * 6 + 4];
        int val = S_BOXES[i][row * 16 + col];
        s_out[i * 4 + 0] = (val >> 3) & 1;
        s_out[i * 4 + 1] = (val >> 2) & 1;
        s_out[i * 4 + 2] = (val >> 1) & 1;
        s_out[i * 4 + 3] = val & 1;
    }

    for (i = 0; i < 32; i++) {
        result = (result << 1) | s_out[P[i] - 1];
    }
    return result;
}

/* Encrypt / Decrypt 64-bit block */
uint64_t des_cipher(uint64_t block, const uint64_t subkeys[16]) {
    int in_bits[64], ip_bits[64];
    uint32_t L, R;
    int i, r;

    for (i = 0; i < 64; i++) {
        in_bits[i] = (block >> (63 - i)) & 1;
    }
    for (i = 0; i < 64; i++) {
        ip_bits[i] = in_bits[IP[i] - 1];
    }

    L = 0; R = 0;
    for (i = 0; i < 32; i++) {
        L = (L << 1) | ip_bits[i];
        R = (R << 1) | ip_bits[32 + i];
    }

    for (r = 0; r < 16; r++) {
        uint32_t f = des_feistel(R, subkeys[r]);
        uint32_t new_R = L ^ f;
        L = R;
        R = new_R;
    }

    /* Pre-output swap (R followed by L) */
    int comb[64];
    for (i = 0; i < 32; i++) {
        comb[i] = (R >> (31 - i)) & 1;
        comb[32 + i] = (L >> (31 - i)) & 1;
    }

    uint64_t out = 0;
    for (i = 0; i < 64; i++) {
        out = (out << 1) | comb[INV_IP[i] - 1];
    }
    return out;
}

uint64_t des_encrypt(uint64_t pt, const uint64_t subkeys[16]) {
    return des_cipher(pt, subkeys);
}

uint64_t des_decrypt(uint64_t ct, const uint64_t subkeys[16]) {
    uint64_t rev_keys[16];
    int i;
    for (i = 0; i < 16; i++) {
        rev_keys[i] = subkeys[15 - i];
    }
    return des_cipher(ct, rev_keys);
}

