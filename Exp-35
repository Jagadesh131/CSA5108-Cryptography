/*
 * ============================================================================
 * Experiment 35: One-Time Pad (OTP) Version of the Vigenère Cipher
 * ============================================================================
 * Question:
 * 35. Write a C program for one-time pad version of the Vigenère cipher.
 *     In this scheme, the key is a stream of random numbers between 0 and 26.
 *     For example, if the key is 3 19 5 . . . , then the first letter of
 *     plaintext is encrypted with a shift of 3 letters, the second with a
 *     shift of 19 letters, the third with a shift of 5 letters, and so on.
 * ============================================================================
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <time.h>

void otp_encrypt(const char *plaintext, const int *key, char *ciphertext, int len) {
    int i;
    for (i = 0; i < len; i++) {
        char ch = toupper((unsigned char)plaintext[i]);
        if (ch >= 'A' && ch <= 'Z') {
            int p = ch - 'A';
            int c = (p + key[i]) % 26;
            ciphertext[i] = 'A' + c;
        } else {
            ciphertext[i] = ch;
        }
    }
    ciphertext[len] = '\0';
}

void otp_decrypt(const char *ciphertext, const int *key, char *plaintext, int len) {
    int i;
    for (i = 0; i < len; i++) {
        char ch = toupper((unsigned char)ciphertext[i]);
        if (ch >= 'A' && ch <= 'Z') {
            int c = ch - 'A';
            int p = (c - key[i] + 26) % 26;
            plaintext[i] = 'A' + p;
        } else {
            plaintext[i] = ch;
        }
    }
    plaintext[len] = '\0';
}

int main() {
    char plaintext[] = "CRYPTOGRAPHY";
    int len = strlen(plaintext);
    int key[100];
    char ciphertext[100];
    char decrypted[100];
    int i;

    printf("============================================================\n");
    printf("Experiment 35: One-Time Pad Version of Vigenere Cipher\n");
    printf("============================================================\n");

    /* Example from question: random shifts between 0 and 25 */
    /* Using deterministic seed for repeatable verification, plus random demo */
    int sample_key[] = { 3, 19, 5, 12, 8, 21, 14, 2, 7, 18, 25, 10 };
    for (i = 0; i < len; i++) {
        key[i] = sample_key[i % 12];
    }

    printf("Original Plaintext : %s (Length = %d)\n", plaintext, len);
    printf("One-Time Pad Key   : ");
    for (i = 0; i < len; i++) {
        printf("%d ", key[i]);
    }
    printf("\n");

    /* Encryption: C_i = (P_i + K_i) mod 26 */
    printf("\n--- Letter-by-Letter Encryption ---\n");
    for (i = 0; i < len; i++) {
        int p_val = toupper((unsigned char)plaintext[i]) - 'A';
        int c_val = (p_val + key[i]) % 26;
        printf("  Pos %2d: '%c' (%2d) + shift %2d = '%c' (%2d)\n",
               i + 1, plaintext[i], p_val, key[i], 'A' + c_val, c_val);
    }

    otp_encrypt(plaintext, key, ciphertext, len);
    printf("\nResulting Ciphertext: %s\n", ciphertext);

    /* Decryption: P_i = (C_i - K_i + 26) mod 26 */
    printf("\n--- Letter-by-Letter Decryption ---\n");
    for (i = 0; i < len; i++) {
        int c_val = ciphertext[i] - 'A';
        int p_val = (c_val - key[i] + 26) % 26;
        printf("  Pos %2d: '%c' (%2d) - shift %2d = '%c' (%2d)\n",
               i + 1, ciphertext[i], c_val, key[i], 'A' + p_val, p_val);
    }

    otp_decrypt(ciphertext, key, decrypted, len);
    printf("\nDecrypted Plaintext : %s\n", decrypted);
    printf("Verification        : %s\n",
           (strcmp(plaintext, decrypted) == 0) ? "SUCCESSFUL MATCH" : "FAILED");

    /* Demonstration of Perfect Secrecy (Shannon's Theorem) */
    printf("\n--- Demonstration of Perfect Secrecy (Shannon's Theorem) ---\n");
    printf("Suppose an eavesdropper sees ciphertext '%s'.\n", ciphertext);
    printf("With a different valid random key, it decrypts to a completely\n");
    printf("different, equally plausible English word of same length:\n");

    char alt_plain[] = "HELLOWORLDS!";
    int alt_len = strlen(alt_plain);
    int alt_key[100];
    for (i = 0; i < alt_len; i++) {
        int c_val = ciphertext[i] - 'A';
        int p_val = toupper((unsigned char)alt_plain[i]) - 'A';
        alt_key[i] = (c_val - p_val + 26) % 26;
    }

    printf("  Target Alternative Word : %s\n", alt_plain);
    printf("  Required Key Stream     : ");
    for (i = 0; i < alt_len; i++) printf("%d ", alt_key[i]);
    printf("\n");

    char alt_recovered[100];
    otp_decrypt(ciphertext, alt_key, alt_recovered, alt_len);
    printf("  Decryption with Alt Key : %s\n", alt_recovered);
    printf("Because all keys are equally likely, ciphertext leaks ZERO information!\n");
    printf("============================================================\n");

    return 0;
}
