#include <stdio.h>
#include <string.h>

int main() {
    char plaintext[] = "HELLO CBC MODE";
    unsigned char key = 7;
    unsigned char iv = 10;
    unsigned char cipher[100];
    int i, len = strlen(plaintext);

    printf("Plaintext: %s\n", plaintext);
    printf("Ciphertext (hex): ");

    for (i = 0; i < len; i++) {
        unsigned char block = (unsigned char)plaintext[i];
        unsigned char encrypted = block ^ iv ^ key;

        cipher[i] = encrypted;
        iv = encrypted;

        printf("%02X", cipher[i]);
    }

    printf("\n");
    return 0;
}
