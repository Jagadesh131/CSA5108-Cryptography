#include <stdio.h>
#include <string.h>
#include <ctype.h>

void createMatrix(char key[], char matrix[5][5])
{
    int used[26] = {0};
    int row = 0, col = 0;
    int i;

    for(i = 0; key[i] != '\0'; i++)
    {
        char ch = toupper(key[i]);

        if(ch == 'J')
            ch = 'I';

        if(ch >= 'A' && ch <= 'Z' && used[ch - 'A'] == 0)
        {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;

            if(col == 5)
            {
                col = 0;
                row++;
            }
        }
    }

    for(i = 0; i < 26; i++)
    {
        char ch = 'A' + i;

        if(ch == 'J')
            continue;

        if(used[i] == 0)
        {
            matrix[row][col] = ch;
            used[i] = 1;

            col++;

            if(col == 5)
            {
                col = 0;
                row++;
            }
        }
    }
}

void findPosition(char matrix[5][5], char ch, int *row, int *col)
{
    int i, j;

    if(ch == 'J')
        ch = 'I';

    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
        {
            if(matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

int main()
{
    char key[50];
    char cipher[500];
    char matrix[5][5];

    int i;
    int r1, c1, r2, c2;

    printf("Enter keyword: ");
    scanf("%s", key);

    printf("Enter ciphertext: ");
    scanf("%s", cipher);

    createMatrix(key, matrix);

    printf("\nPlayfair Matrix:\n");

    for(i = 0; i < 5; i++)
    {
        printf("%c %c %c %c %c\n",
               matrix[i][0],
               matrix[i][1],
               matrix[i][2],
               matrix[i][3],
               matrix[i][4]);
    }

    printf("\nDecrypted text: ");

    for(i = 0; cipher[i] != '\0'; i += 2)
    {
        findPosition(matrix, cipher[i], &r1, &c1);
        findPosition(matrix, cipher[i + 1], &r2, &c2);

        if(r1 == r2)
        {
            printf("%c", matrix[r1][(c1 + 4) % 5]);
            printf("%c", matrix[r2][(c2 + 4) % 5]);
        }
        else if(c1 == c2)
        {
            printf("%c", matrix[(r1 + 4) % 5][c1]);
            printf("%c", matrix[(r2 + 4) % 5][c2]);
        }
        else
        {
            printf("%c", matrix[r1][c2]);
            printf("%c", matrix[r2][c1]);
        }
    }

    printf("\n");

    return 0;
}
