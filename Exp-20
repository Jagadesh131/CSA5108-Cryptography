
#include <stdio.h>

int main() {
    int n, i;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    if (n < 2) {
        printf("Enter at least 2 blocks.\n");
        return 0;
    }

    printf("\nECB mode, error in C1:\n");
    for (i = 1; i <= n; i++) {
        if (i == 1)
            printf("P%d: Corrupted\n", i);
        else
            printf("P%d: Unaffected\n", i);
    }

    printf("\nCBC mode, transmission error in C1:\n");
    for (i = 1; i <= n; i++) {
        if (i == 1)
            printf("P%d: Corrupted unpredictably\n", i);
        else if (i == 2)
            printf("P%d: Corresponding bit is flipped\n", i);
        else
            printf("P%d: Unaffected\n", i);
    }

    printf("\nCBC mode, bit error in source plaintext P1:\n");
    for (i = 1; i <= n; i++)
        printf("P%d: May be corrupted after decryption\n", i);

    return 0;
}
