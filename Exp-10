#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char matrix[5][5] = {
        {'M','F','H','I','K'},
        {'U','N','O','P','Q'},
        {'Z','V','W','X','Y'},
        {'E','L','A','R','G'},
        {'D','S','T','B','C'}
    };

    char plaintext[] = "MUSTSEEYOUOVERCADOGANWESTCOMINGATONCE";
    char text[200];
    int len = 0;
    int i, r1, c1, r2, c2;

    /* Remove non-alphabetic characters */
    for(i = 0; plaintext[i] != '\0'; i++)
    {
        if(isalpha(plaintext[i]))
        {
            text[len++] = toupper(plaintext[i]);
        }
    }

    text[len] = '\0';

    printf("Plaintext: %s\n", text);

    printf("Ciphertext: ");

    for(i = 0; i < len; i += 2)
    {
        int x, y;

        /* Find first letter */
        for(r1 = 0; r1 < 5; r1++)
        {
            for(c1 = 0; c1 < 5; c1++)
            {
                if(matrix[r1][c1] == text[i])
                    goto found1;
            }
        }

        found1:

        /* Find second letter */
        for(r2 = 0; r2 < 5; r2++)
        {
            for(c2 = 0; c2 < 5; c2++)
            {
                if(matrix[r2][c2] == text[i + 1])
                    goto found2;
            }
        }

        found2:

        if(r1 == r2)
        {
            printf("%c", matrix[r1][(c1 + 1) % 5]);
            printf("%c", matrix[r2][(c2 + 1) % 5]);
        }
        else if(c1 == c2)
        {
            printf("%c", matrix[(r1 + 1) % 5][c1]);
            printf("%c", matrix[(r2 + 1) % 5][c2]);
        }
        else
        {
            printf("%c", matrix[r1][c2]);
            printf("%c", matrix[r2][c1]);
        }
    }

    printf("\n");

    return 0;
}
