
#include <stdio.h>
#include <math.h>

long double factorial(int n) {
    long double fact = 1;
    int i;

    for (i = 1; i <= n; i++)
        fact *= i;

    return fact;
}

int main(void) {
    long double totalKeys, uniqueKeys;
    long double powerTotal, powerUnique;

    totalKeys = factorial(25);
    uniqueKeys = factorial(24);

    powerTotal = log2l(totalKeys);
    powerUnique = log2l(uniqueKeys);

    printf("Total possible keys (25!): %.0Lf\n", totalKeys);
    printf("Approximate power of 2: 2^%.2Lf\n", powerTotal);

    printf("\nEffectively unique keys (24!): %.0Lf\n", uniqueKeys);
    printf("Approximate power of 2: 2^%.2Lf\n", powerUnique);

    return 0;
}
