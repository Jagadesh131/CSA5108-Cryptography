/*
 * ============================================================================
 * Experiment 21: Modes of Operation (ECB, CBC, CFB) and Block Padding
 * ============================================================================
 * Question:
 * 21. Write a C program for ECB, CBC, and CFB modes, the plaintext must be a
 *     sequence of one or more complete data blocks (or, for CFB mode, data
 *     segments). In other words, for these three modes, the total number of
 *     bits in the plaintext must be a positive multiple of the block (or
 *     segment) size. One common method of padding, if needed, consists of a
 *     1 bit followed by as few zero bits, possibly none, as are necessary to
 *     complete the final block. It is considered good practice for the sender
 *     to pad every message, including messages in which the final message block
 *     is already complete. What is the motivation for including a padding block
 *     when padding is not needed?
 *
 * ============================================================================
 * MOTIVATION FOR INCLUDING A PADDING BLOCK WHEN PADDING IS NOT NEEDED:
 * ============================================================================
 * 1. Unambiguous Depadding at Receiver:
 *    If padding were only added when a message is not an exact multiple of the
 *    block size, the receiver would have no way of knowing whether the last
 *    block contains padding or if the plaintext naturally ended with a '1' bit
 *    followed by '0' bits.
 *
 * 2. Deterministic & Uniform Rule:
 *    When the sender unconditionally pads every message (even messages whose
 *    length is already an exact multiple of the block size, by appending a full
 *    padding block starting with a '1' bit followed by all '0' bits):
 *    - The receiver always applies the exact same rule without needing extra
 *      metadata or length fields.
 *    - The receiver simply scans backwards from the end of the decrypted
 *      message, strips all trailing '0' bits, and removes the first '1' bit.
 *    - Everything preceding that '1' bit is guaranteed to be the exact original
 *      plaintext.
 *    - No valid user data is ever mistakenly stripped or corrupted.
 * ============================================================================
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define BLOCK_SIZE 8 /* 64-bit block size (8 bytes) */

/*
 * Illustrative 64-bit Feistel block cipher
 * Uses 4 rounds with subkeys derived from the 8-byte key.
 */
static uint32_t round_func(uint32_t r, uint32_t subkey) {
    uint32_t x = r ^ subkey;
    x = ((x << 5) | (x >> 27)) + 0x9E3779B9;
    return x;
}

void encrypt_block(const uint8_t in[BLOCK_SIZE], uint8_t out[BLOCK_SIZE], const uint8_t key[BLOCK_SIZE]) {
    uint32_t L = ((uint32_t)in[0] << 24) | ((uint32_t)in[1] << 16) | ((uint32_t)in[2] << 8) | (uint32_t)in[3];
    uint32_t R = ((uint32_t)in[4] << 24) | ((uint32_t)in[5] << 16) | ((uint32_t)in[6] << 8) | (uint32_t)in[7];
    uint32_t K1 = ((uint32_t)key[0] << 24) | ((uint32_t)key[1] << 16) | ((uint32_t)key[2] << 8) | (uint32_t)key[3];
    uint32_t K2 = ((uint32_t)key[4] << 24) | ((uint32_t)key[5] << 16) | ((uint32_t)key[6] << 8) | (uint32_t)key[7];
    uint32_t subkeys[4] = { K1, K2, K1 ^ 0x55555555, K2 ^ 0xAAAAAAAA };
    int i;

    for (i = 0; i < 4; i++) {
        uint32_t next_R = L ^ round_func(R, subkeys[i]);
        L = R;
        R = next_R;
    }

    out[0] = (uint8_t)(R >> 24); out[1] = (uint8_t)(R >> 16); out[2] = (uint8_t)(R >> 8); out[3] = (uint8_t)R;
    out[4] = (uint8_t)(L >> 24); out[5] = (uint8_t)(L >> 16); out[6] = (uint8_t)(L >> 8); out[7] = (uint8_t)L;
}

void decrypt_block(const uint8_t in[BLOCK_SIZE], uint8_t out[BLOCK_SIZE], const uint8_t key[BLOCK_SIZE]) {
    uint32_t R = ((uint32_t)in[0] << 24) | ((uint32_t)in[1] << 16) | ((uint32_t)in[2] << 8) | (uint32_t)in[3];
    uint32_t L = ((uint32_t)in[4] << 24) | ((uint32_t)in[5] << 16) | ((uint32_t)in[6] << 8) | (uint32_t)in[7];
    uint32_t K1 = ((uint32_t)key[0] << 24) | ((uint32_t)key[1] << 16) | ((uint32_t)key[2] << 8) | (uint32_t)key[3];
    uint32_t K2 = ((uint32_t)key[4] << 24) | ((uint32_t)key[5] << 16) | ((uint32_t)key[6] << 8) | (uint32_t)key[7];
    uint32_t subkeys[4] = { K1, K2, K1 ^ 0x55555555, K2 ^ 0xAAAAAAAA };
    int i;

    for (i = 3; i >= 0; i--) {
        uint32_t prev_L = R ^ round_func(L, subkeys[i]);
        R = L;
        L = prev_L;
    }

    out[0] = (uint8_t)(L >> 24); out[1] = (uint8_t)(L >> 16); out[2] = (uint8_t)(L >> 8); out[3] = (uint8_t)L;
    out[4] = (uint8_t)(R >> 24); out[5] = (uint8_t)(R >> 16); out[6] = (uint8_t)(R >> 8); out[7] = (uint8_t)R;
}

/*
 * Bit padding (ISO/IEC 7816-4 bit padding):
 * A 1-bit followed by as few 0-bits as necessary (0x80 byte followed by 0x00 bytes).
 * Even if the message is already an exact multiple of the block size, an entire
 * dummy block (0x80 followed by seven 0x00 bytes) is appended.
 */
int pad_message(const uint8_t *in, int in_len, uint8_t *out) {
    int pad_len = BLOCK_SIZE - (in_len % BLOCK_SIZE);
    int total_len;
    int i;

    if (pad_len == 0) {
        pad_len = BLOCK_SIZE;
    }

    total_len = in_len + pad_len;

    memcpy(out, in, in_len);
    out[in_len] = 0x80; /* '1' bit followed by '0' bits */
    for (i = in_len + 1; i < total_len; i++) {
        out[i] = 0x00;
    }

    return total_len;
}

/*
 * Depadding:
 * Strips trailing 0x00 bytes until the first 0x80 byte is found and removed.
 */
int unpad_message(const uint8_t *in, int total_len, uint8_t *out) {
    int i = total_len - 1;

    while (i >= 0 && in[i] == 0x00) {
        i--;
    }

    if (i < 0 || in[i] != 0x80) {
        printf("Error: Invalid padding detected!\n");
        return -1;
    }

    memcpy(out, in, i);
    out[i] = '\0';
    return i;
}

void print_hex(const char *label, const uint8_t *data, int len) {
    int i;
    printf("%-20s: ", label);
    for (i = 0; i < len; i++) {
        printf("%02X ", data[i]);
    }
    printf("\n");
}

/* 1. Electronic Codebook (ECB) Mode */
void ecb_encrypt(const uint8_t *pt, int len, uint8_t *ct, const uint8_t *key) {
    int i;
    for (i = 0; i < len; i += BLOCK_SIZE) {
        encrypt_block(pt + i, ct + i, key);
    }
}

void ecb_decrypt(const uint8_t *ct, int len, uint8_t *dt, const uint8_t *key) {
    int i;
    for (i = 0; i < len; i += BLOCK_SIZE) {
        decrypt_block(ct + i, dt + i, key);
    }
}

/* 2. Cipher Block Chaining (CBC) Mode */
void cbc_encrypt(const uint8_t *pt, int len, uint8_t *ct, const uint8_t *key, const uint8_t *iv) {
    uint8_t prev[BLOCK_SIZE];
    uint8_t block[BLOCK_SIZE];
    int i, j;

    memcpy(prev, iv, BLOCK_SIZE);
    for (i = 0; i < len; i += BLOCK_SIZE) {
        for (j = 0; j < BLOCK_SIZE; j++) {
            block[j] = pt[i + j] ^ prev[j];
        }
        encrypt_block(block, ct + i, key);
        memcpy(prev, ct + i, BLOCK_SIZE);
    }
}

void cbc_decrypt(const uint8_t *ct, int len, uint8_t *dt, const uint8_t *key, const uint8_t *iv) {
    uint8_t prev[BLOCK_SIZE];
    uint8_t block[BLOCK_SIZE];
    int i, j;

    memcpy(prev, iv, BLOCK_SIZE);
    for (i = 0; i < len; i += BLOCK_SIZE) {
        decrypt_block(ct + i, block, key);
        for (j = 0; j < BLOCK_SIZE; j++) {
            dt[i + j] = block[j] ^ prev[j];
        }
        memcpy(prev, ct + i, BLOCK_SIZE);
    }
}

/* 3. Cipher Feedback (CFB) Mode (Full block segment size = BLOCK_SIZE) */
void cfb_encrypt(const uint8_t *pt, int len, uint8_t *ct, const uint8_t *key, const uint8_t *iv) {
    uint8_t shift_reg[BLOCK_SIZE];
    uint8_t out_block[BLOCK_SIZE];
    int i, j;

    memcpy(shift_reg, iv, BLOCK_SIZE);
    for (i = 0; i < len; i += BLOCK_SIZE) {
        encrypt_block(shift_reg, out_block, key);
        for (j = 0; j < BLOCK_SIZE; j++) {
            ct[i + j] = pt[i + j] ^ out_block[j];
        }
        memcpy(shift_reg, ct + i, BLOCK_SIZE);
    }
}

void cfb_decrypt(const uint8_t *ct, int len, uint8_t *dt, const uint8_t *key, const uint8_t *iv) {
    uint8_t shift_reg[BLOCK_SIZE];
    uint8_t out_block[BLOCK_SIZE];
    int i, j;

    memcpy(shift_reg, iv, BLOCK_SIZE);
    for (i = 0; i < len; i += BLOCK_SIZE) {
        /* Note: Block cipher ENCRYPTION is used in CFB decryption */
        encrypt_block(shift_reg, out_block, key);
        for (j = 0; j < BLOCK_SIZE; j++) {
            dt[i + j] = ct[i + j] ^ out_block[j];
        }
        memcpy(shift_reg, ct + i, BLOCK_SIZE);
    }
}

void demonstrate_modes(const char *title, const char *msg, const uint8_t *key, const uint8_t *iv) {
    int orig_len = strlen(msg);
    uint8_t padded[256];
    uint8_t cipher[256];
    uint8_t decrypted[256];
    uint8_t recovered[256];
    int padded_len, recovered_len;

    printf("\n============================================================\n");
    printf("DEMONSTRATION: %s\n", title);
    printf("============================================================\n");
    printf("Original Message    : \"%s\"\n", msg);
    printf("Original Length     : %d bytes (%d bits)\n", orig_len, orig_len * 8);

    padded_len = pad_message((const uint8_t *)msg, orig_len, padded);
    printf("Padded Length       : %d bytes (%d blocks)\n", padded_len, padded_len / BLOCK_SIZE);
    if (orig_len % BLOCK_SIZE == 0) {
        printf("Note                : Plaintext was already a multiple of block size.\n");
        printf("                      A full %d-byte padding block was added!\n", BLOCK_SIZE);
    }
    print_hex("Padded Plaintext", padded, padded_len);

    /* --- ECB Mode --- */
    printf("\n--- 1. Electronic Codebook (ECB) Mode ---\n");
    ecb_encrypt(padded, padded_len, cipher, key);
    print_hex("Ciphertext (ECB)", cipher, padded_len);
    ecb_decrypt(cipher, padded_len, decrypted, key);
    recovered_len = unpad_message(decrypted, padded_len, recovered);
    printf("Decrypted & Unpadded: \"%s\" (Length: %d)\n", recovered, recovered_len);

    /* --- CBC Mode --- */
    printf("\n--- 2. Cipher Block Chaining (CBC) Mode ---\n");
    cbc_encrypt(padded, padded_len, cipher, key, iv);
    print_hex("Ciphertext (CBC)", cipher, padded_len);
    cbc_decrypt(cipher, padded_len, decrypted, key, iv);
    recovered_len = unpad_message(decrypted, padded_len, recovered);
    printf("Decrypted & Unpadded: \"%s\" (Length: %d)\n", recovered, recovered_len);

    /* --- CFB Mode --- */
    printf("\n--- 3. Cipher Feedback (CFB) Mode ---\n");
    cfb_encrypt(padded, padded_len, cipher, key, iv);
    print_hex("Ciphertext (CFB)", cipher, padded_len);
    cfb_decrypt(cipher, padded_len, decrypted, key, iv);
    recovered_len = unpad_message(decrypted, padded_len, recovered);
    printf("Decrypted & Unpadded: \"%s\" (Length: %d)\n", recovered, recovered_len);
}

void print_theoretical_answer() {
    printf("\n============================================================\n");
    printf("QUESTION 21 & MOTIVATION EXPLANATION\n");
    printf("============================================================\n");
    printf("Question:\n");
    printf("  What is the motivation for including a padding block when\n");
    printf("  padding is not needed (i.e. message is already complete)?\n\n");
    printf("Answer / Motivation:\n");
    printf("  1. Unambiguous Depadding at Receiver:\n");
    printf("     If padding were only added when a message is not a multiple\n");
    printf("     of the block size, the receiver cannot distinguish whether\n");
    printf("     the trailing '100...0' pattern in a message is padding or\n");
    printf("     actual legitimate message data.\n\n");
    printf("  2. Consistent and Deterministic Protocol:\n");
    printf("     By mandating that EVERY message is padded (even full blocks\n");
    printf("     by appending a full dummy block of 0x80 followed by 0x00s),\n");
    printf("     the receiver always safely removes padding from every message.\n");
    printf("     The receiver simply scans backward from the end, finds the\n");
    printf("     first 1-bit (0x80), and strips it along with all trailing 0s.\n");
    printf("     This guarantees complete data integrity without ambiguity.\n");
    printf("============================================================\n");
}

int main() {
    uint8_t key[BLOCK_SIZE] = { 0x13, 0x57, 0x9B, 0xDF, 0x24, 0x68, 0xAC, 0xE0 };
    uint8_t iv[BLOCK_SIZE]  = { 0xFE, 0xDC, 0xBA, 0x98, 0x76, 0x54, 0x32, 0x10 };
    char user_input[256];

    print_theoretical_answer();

    /* Demonstration 1: Partial block (needs padding to complete block) */
    demonstrate_modes("Case 1: Message needing padding (11 bytes)", "HELLO WORLD", key, iv);

    /* Demonstration 2: Already complete block (16 bytes = 2 exact blocks of 8 bytes) */
    demonstrate_modes("Case 2: Message already complete multiple of block size (16 bytes)", "COMPLETE_BLOCKS!", key, iv);

    /* Optional user input */
    printf("\n============================================================\n");
    printf("INTERACTIVE TEST:\n");
    printf("Enter custom plaintext (or press Enter to skip): ");
    if (fgets(user_input, sizeof(user_input), stdin)) {
        int len = strlen(user_input);
        if (len > 0 && user_input[len - 1] == '\n') {
            user_input[len - 1] = '\0';
            len--;
        }
        if (len > 0) {
            demonstrate_modes("Custom User Input", user_input, key, iv);
        }
    }

    return 0;
}
