/*
 * ============================================================================
 * Experiment 22: Cipher Block Chaining (CBC) Mode with Simplified DES (S-DES)
 * ============================================================================
 * Question:
 * 22. Write a C program for Encrypt and decrypt in cipher block chaining mode
 *     using one of the following ciphers: affine modulo 256, Hill modulo 256,
 *     S-DES, DES. Test data for S-DES using a binary initialization vector of
 *     1010 1010. A binary plaintext of 0000 0001 0010 0011 encrypted with a
 *     binary key of 01111 11101 should give a binary ciphertext of
 *     1111 0100 0000 1011. Decryption should work correspondingly.
 * ============================================================================
 */

#include <stdio.h>
#include <stdint.h>

/* S-DES Permutations & S-Boxes */
static const int P10[] = { 3, 5, 2, 7, 4, 10, 1, 9, 8, 6 };
static const int P8[]  = { 6, 3, 7, 4, 8, 5, 10, 9 };
static const int IP[]  = { 2, 6, 3, 1, 4, 8, 5, 7 };
static const int INV_IP[] = { 4, 1, 3, 5, 7, 2, 8, 6 };
static const int EP[]  = { 4, 1, 2, 3, 2, 3, 4, 1 };
static const int P4[]  = { 2, 4, 3, 1 };

static const int S0[4][4] = {
    { 1, 0, 3, 2 },
    { 3, 2, 1, 0 },
    { 0, 2, 1, 3 },
    { 3, 1, 3, 2 }
};

static const int S1[4][4] = {
    { 0, 1, 2, 3 },
    { 2, 0, 1, 3 },
    { 3, 0, 1, 0 },
    { 2, 1, 0, 3 }
};

void print_binary8(uint8_t val) {
    int i;
    for (i = 7; i >= 0; i--) {
        printf("%d", (val >> i) & 1);
        if (i == 4) printf(" ");
    }
}

void print_binary10(uint16_t val) {
    int i;
    for (i = 9; i >= 0; i--) {
        printf("%d", (val >> i) & 1);
        if (i == 5) printf(" ");
    }
}

void sdes_key_schedule(uint16_t key10, uint8_t *k1, uint8_t *k2) {
    int bits[10], p10_bits[10];
    int l1[5], r1[5], l2[5], r2[5];
    int c1[10], c2[10];
    int i;

    for (i = 0; i < 10; i++) {
        bits[i] = (key10 >> (9 - i)) & 1;
    }
    for (i = 0; i < 10; i++) {
        p10_bits[i] = bits[P10[i] - 1];
    }

    /* LS-1 */
    for (i = 0; i < 5; i++) {
        l1[i] = p10_bits[(i + 1) % 5];
        r1[i] = p10_bits[5 + ((i + 1) % 5)];
        c1[i] = l1[i];
        c1[5 + i] = r1[i];
    }

    /* K1 from P8 */
    *k1 = 0;
    for (i = 0; i < 8; i++) {
        *k1 = (*k1 << 1) | c1[P8[i] - 1];
    }

    /* LS-2 on L1, R1 */
    for (i = 0; i < 5; i++) {
        l2[i] = l1[(i + 2) % 5];
        r2[i] = r1[(i + 2) % 5];
        c2[i] = l2[i];
        c2[5 + i] = r2[i];
    }

    /* K2 from P8 */
    *k2 = 0;
    for (i = 0; i < 8; i++) {
        *k2 = (*k2 << 1) | c2[P8[i] - 1];
    }
}

static uint8_t f_k(uint8_t r_nibble, uint8_t subkey) {
    int r_bits[4], ep_bits[8], xored[8];
    int l_nib[4], r_nib[4];
    int r0, c0, r1, c1, v0, v1;
    int out4[4], p4_out[4];
    uint8_t result = 0;
    int i;

    for (i = 0; i < 4; i++) {
        r_bits[i] = (r_nibble >> (3 - i)) & 1;
    }
    for (i = 0; i < 8; i++) {
        ep_bits[i] = r_bits[EP[i] - 1];
        xored[i] = ep_bits[i] ^ ((subkey >> (7 - i)) & 1);
    }
    for (i = 0; i < 4; i++) {
        l_nib[i] = xored[i];
        r_nib[i] = xored[4 + i];
    }

    r0 = (l_nib[0] << 1) | l_nib[3];
    c0 = (l_nib[1] << 1) | l_nib[2];
    v0 = S0[r0][c0];

    r1 = (r_nib[0] << 1) | r_nib[3];
    c1 = (r_nib[1] << 1) | r_nib[2];
    v1 = S1[r1][c1];

    out4[0] = (v0 >> 1) & 1;
    out4[1] = v0 & 1;
    out4[2] = (v1 >> 1) & 1;
    out4[3] = v1 & 1;

    for (i = 0; i < 4; i++) {
        p4_out[i] = out4[P4[i] - 1];
        result = (result << 1) | p4_out[i];
    }
    return result;
}

uint8_t sdes_encrypt_byte(uint8_t pt, uint8_t k1, uint8_t k2) {
    int pt_bits[8], ip_bits[8];
    uint8_t L, R, new_L, new_R, out_L, out_R;
    int comb[8];
    uint8_t result = 0;
    int i;

    for (i = 0; i < 8; i++) {
        pt_bits[i] = (pt >> (7 - i)) & 1;
    }
    for (i = 0; i < 8; i++) {
        ip_bits[i] = pt_bits[IP[i] - 1];
    }

    L = (ip_bits[0] << 3) | (ip_bits[1] << 2) | (ip_bits[2] << 1) | ip_bits[3];
    R = (ip_bits[4] << 3) | (ip_bits[5] << 2) | (ip_bits[6] << 1) | ip_bits[7];

    /* Round 1 */
    new_R = L ^ f_k(R, k1);
    new_L = R;

    /* Round 2 */
    out_L = new_L ^ f_k(new_R, k2);
    out_R = new_R;

    for (i = 0; i < 4; i++) {
        comb[i] = (out_L >> (3 - i)) & 1;
        comb[4 + i] = (out_R >> (3 - i)) & 1;
    }
    for (i = 0; i < 8; i++) {
        result = (result << 1) | comb[INV_IP[i] - 1];
    }
    return result;
}

uint8_t sdes_decrypt_byte(uint8_t ct, uint8_t k1, uint8_t k2) {
    int ct_bits[8], ip_bits[8];
    uint8_t L, R, new_L, new_R, out_L, out_R;
    int comb[8];
    uint8_t result = 0;
    int i;

    for (i = 0; i < 8; i++) {
        ct_bits[i] = (ct >> (7 - i)) & 1;
    }
    for (i = 0; i < 8; i++) {
        ip_bits[i] = ct_bits[IP[i] - 1];
    }

    L = (ip_bits[0] << 3) | (ip_bits[1] << 2) | (ip_bits[2] << 1) | ip_bits[3];
    R = (ip_bits[4] << 3) | (ip_bits[5] << 2) | (ip_bits[6] << 1) | ip_bits[7];

    /* Round 1 with K2 */
    new_R = L ^ f_k(R, k2);
    new_L = R;

    /* Round 2 with K1 */
    out_L = new_L ^ f_k(new_R, k1);
    out_R = new_R;

    for (i = 0; i < 4; i++) {
        comb[i] = (out_L >> (3 - i)) & 1;
        comb[4 + i] = (out_R >> (3 - i)) & 1;
    }
    for (i = 0; i < 8; i++) {
        result = (result << 1) | comb[INV_IP[i] - 1];
    }
    return result;
}

int main() {
    uint16_t key = 0x1FD; /* 01111 11101 (binary) */
    uint8_t iv   = 0xAA;  /* 1010 1010 (binary) */
    uint8_t p[2] = { 0x01, 0x23 }; /* 0000 0001, 0010 0011 */
    uint8_t c[2];
    uint8_t d[2];
    uint8_t k1, k2;

    printf("============================================================\n");
    printf("Experiment 22: CBC Mode with S-DES\n");
    printf("============================================================\n");

    sdes_key_schedule(key, &k1, &k2);

    printf("Key                : "); print_binary10(key); printf(" (0x%03X)\n", key);
    printf("K1                 : "); print_binary8(k1); printf("\n");
    printf("K2                 : "); print_binary8(k2); printf("\n");
    printf("IV                 : "); print_binary8(iv); printf("\n");
    printf("Plaintext Block 1  : "); print_binary8(p[0]); printf("\n");
    printf("Plaintext Block 2  : "); print_binary8(p[1]); printf("\n");

    /* CBC Encryption:
     * C1 = E(K, P1 ^ IV)
     * C2 = E(K, P2 ^ C1)
     */
    c[0] = sdes_encrypt_byte(p[0] ^ iv, k1, k2);
    c[1] = sdes_encrypt_byte(p[1] ^ c[0], k1, k2);

    printf("\n--- CBC Encryption Result ---\n");
    printf("Ciphertext Block 1 : "); print_binary8(c[0]); printf(" (Expected: 1111 0100)\n");
    printf("Ciphertext Block 2 : "); print_binary8(c[1]); printf(" (Expected: 0000 1011)\n");

    /* CBC Decryption:
     * P1 = D(K, C1) ^ IV
     * P2 = D(K, C2) ^ C1
     */
    d[0] = sdes_decrypt_byte(c[0], k1, k2) ^ iv;
    d[1] = sdes_decrypt_byte(c[1], k1, k2) ^ c[0];

    printf("\n--- CBC Decryption Result ---\n");
    printf("Decrypted Block 1  : "); print_binary8(d[0]); printf("\n");
    printf("Decrypted Block 2  : "); print_binary8(d[1]); printf("\n");

    if (c[0] == 0xF4 && c[1] == 0x0B && d[0] == p[0] && d[1] == p[1]) {
        printf("\nSUCCESS: S-DES CBC matches test data perfectly!\n");
    } else {
        printf("\nFAILURE: Outputs do not match test data!\n");
    }
    printf("============================================================\n");

    return 0;
}
